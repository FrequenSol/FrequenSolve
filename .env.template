#-----------------------------------------------------------------------------------
#                       READ BEFORE YOU EDIT THIS FILE !!!
#-----------------------------------------------------------------------------------
# IMPORTANT: This is a TEMPLATE file used to configure environment variables for
#            Frequensolve, including secrets. You can use this template to set
#            environment variables that are used by FrequenSolve, or you can set
#            the environment variables directly in your environment.
#
#            Copy this template to FrequenSolve/.env and do NOT commit your .env file
#            and do NOT edit this template (it will not be seen by the code and
#            further runs the risk of exposing your private information).
#-----------------------------------------------------------------------------------

FS_PYTHON_PATH=

# REQUIRED: Paths to Frequensolve executables on any machine you intend to run the solver code
FRONTERA_SOLVER_EXECUTABLE=     # Path to Frequensolve executable on Frontera
LOCAL_SOLVER_EXECUTABLE=        # Path to Frequensolve executable on local machine

# Optional: Path to work directory on Frontera
FRONTERA_WORK_DIR=             # Path to work directory on Frontera


# CONVENIENCE: If you do not set these, you will be prompted to enter them each time you connect to
#              a TACC client.
TACC_USERNAME=              # TACC username
TACC_PASSWORD=              # TACC password (if you set up SSH keys, this is not needed)
TACC_ACCOUNT=               # Default TACC allocation to charge jobs to
                            #   (can also be set when submitting jobs)
