{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Execution site job v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "executionSiteId",
    "simulationId",
    "logicalAttemptId",
    "requiredCapabilities",
    "runtime",
    "input",
    "output",
    "resources"
  ],
  "properties": {
    "version": {
      "const": "execution-site-job.v1"
    },
    "executionSiteId": {
      "type": "string",
      "minLength": 1
    },
    "simulationId": {
      "type": "string",
      "minLength": 1
    },
    "logicalAttemptId": {
      "type": "string",
      "minLength": 1
    },
    "requiredCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "digest"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "resources": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nodes",
            "mpiRanks",
            "wallTimeSeconds"
          ],
          "properties": {
            "cpu": {
              "type": "integer",
              "minimum": 1,
              "maximum": 128
            },
            "memoryMiB": {
              "type": "integer",
              "minimum": 1,
              "maximum": 262144
            },
            "nodes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            },
            "mpiRanks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "wallTimeSeconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 7200
            },
            "allowCpuSharing": {
              "type": "boolean",
              "default": false
            },
            "plannerMemoryMiB": {
              "type": "integer",
              "minimum": 1,
              "maximum": 124518
            },
            "mode": {
              "const": "independent-frequency.v1"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "nodes": {
                    "const": 1
                  }
                }
              },
              "then": {
                "properties": {
                  "mpiRanks": {
                    "const": 1
                  }
                }
              },
              "else": {
                "properties": {
                  "mpiRanks": {
                    "enum": [
                      2,
                      4,
                      6,
                      8
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "required": [
                  "allowCpuSharing"
                ],
                "properties": {
                  "allowCpuSharing": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "nodes": {
                    "const": 1
                  },
                  "mpiRanks": {
                    "const": 1
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "nodes",
            "mpiRanks",
            "wallTimeSeconds",
            "pool"
          ],
          "properties": {
            "nodes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            },
            "mpiRanks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "wallTimeSeconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 7200
            },
            "mode": {
              "const": "adaptive-allocation.v1"
            },
            "pool": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "threadsPerRank",
                "memoryMiBPerNode",
                "partition"
              ],
              "properties": {
                "threadsPerRank": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64
                },
                "memoryMiBPerNode": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 124518
                },
                "partition": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
                }
              }
            }
          }
        }
      ]
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "digest"
      ],
      "properties": {
        "version": {
          "const": "adaptive-scheduler.v1"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "partition": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "schedulerPartition": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "catalogRevision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,100}$"
        },
        "allowUnverifiedCompute": {
          "type": "boolean"
        },
        "networkFabric": {
          "type": "string",
          "minLength": 1
        },
        "compatibilityFindings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "partition",
        "schedulerPartition",
        "catalogRevision",
        "allowUnverifiedCompute",
        "networkFabric",
        "compatibilityFindings"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "resources": {
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "const": "adaptive-allocation.v1"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "scheduler"
        ]
      },
      "else": {
        "not": {
          "required": [
            "scheduler"
          ]
        }
      }
    }
  ]
}
