{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Execution site job v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "executionSiteId",
    "simulationId",
    "logicalAttemptId",
    "requiredCapabilities",
    "runtime",
    "input",
    "output",
    "resources"
  ],
  "properties": {
    "version": {
      "const": "execution-site-job.v1"
    },
    "executionSiteId": {
      "type": "string",
      "minLength": 1
    },
    "simulationId": {
      "type": "string",
      "minLength": 1
    },
    "logicalAttemptId": {
      "type": "string",
      "minLength": 1
    },
    "requiredCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "digest"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "mpiRanks",
        "wallTimeSeconds"
      ],
      "properties": {
        "cpu": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "memoryMiB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "nodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "mpiRanks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "wallTimeSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 7200
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "nodes": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "mpiRanks": {
                "const": 1
              }
            }
          },
          "else": {
            "properties": {
              "mpiRanks": {
                "enum": [
                  2,
                  4,
                  6,
                  8
                ]
              }
            }
          }
        }
      ]
    }
  }
}
