                  "type": "string",
                  "default": "global"
                },
                "convention": {
                  "enum": [
                    "local",
                    "NED",
                    "END",
                    "ENU",
                    "ned",
                    "end",
                    "enu"
                  ]
                },
                "weight": {
                  "type": "number"
                },
                "strike": {
                  "$ref": "#/$defs/angle"
                },
                "dip": {
                  "$ref": "#/$defs/angle"
                },
                "rake": {
                  "$ref": "#/$defs/angle"
                },
                "angle_units": {
                  "enum": [
                    "deg",
                    "rad",
                    "degrees",
                    "radians"
                  ]
                },
                "fault_normal": {
                  "$ref": "#/$defs/direction"
                },
                "slip_vector": {
                  "$ref": "#/$defs/direction"
                },
                "axis": {
