                          "properties": {
                            "weight": {
                              "const": 0
                            }
                          }
                        }
                      },
                      {
                        "required": [
                          "axis"
                        ],
                        "properties": {
                          "axis": {
                            "anyOf": [
                              {
                                "required": [
                                  "strike"
                                ]
                              },
                              {
                                "required": [
                                  "azimuth"
                                ]
                              }
                            ],
                            "type": "object"
                          }
                        }
                      }
                    ]
                  },
                  "then": {
                    "not": {
                      "required": [
                        "convention"
                      ]
                    }
                  }
                }
              ]
            },
            "iso": {
              "type": "object",
              "properties": {
                "weight": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "not": {
                "required": [
                  "amplitude",
                  "moment_magnitude"
                ]
              }
            },
            {
              "if": {
                "required": [
                  "moment_magnitude"
                ]
              },
              "then": {
                "not": {
                  "required": [
                    "units"
                  ]
                }
              }
            },
            {
              "if": {
                "required": [
                  "moment_magnitude"
                ]
              },
              "then": {
                "properties": {
                  "normalization": {
                    "const": "scalar_moment"
                  }
                }
              }
            },
            {
              "if": {
                "required": [
                  "dc"
                ],
                "properties": {
                  "dc": {
                    "allOf": [
                      {
                        "not": {
                          "required": [
                            "weight"
                          ],
                          "properties": {
                            "weight": {
                              "const": 0
                            }
                          }
                        }
                      },
                      {
                        "anyOf": [
                          {
                            "required": [
                              "strike"
                            ]
                          },
                          {
                            "required": [
                              "axis"
                            ]
                          }
                        ]
                      }
                    ]
                  }
                }
              },
              "then": {
                "not": {
                  "required": [
                    "convention"
                  ]
                }
              }
            },
            {
              "if": {
                "required": [
                  "clvd"
                ],
                "properties": {
                  "clvd": {
                    "allOf": [
                      {
                        "not": {
                          "required": [
                            "weight"
                          ],
                          "properties": {
                            "weight": {
                              "const": 0
                            }
                          }
                        }
                      },
                      {
                        "required": [
                          "axis"
                        ],
                        "properties": {
                          "axis": {
                            "anyOf": [
                              {
                                "required": [
                                  "strike"
                                ]
                              },
                              {
                                "required": [
                                  "azimuth"
                                ]
                              }
                            ],
                            "type": "object"
                          }
                        }
                      }
                    ]
                  }
                }
              },
              "then": {
                "not": {
                  "required": [
                    "convention"
                  ]
                }
              }
            }
          ],
          "oneOf": [
            {
              "anyOf": [
                {
                  "required": [
                    "dc"
                  ]
                },
                {
                  "required": [
                    "clvd"
                  ]
                },
                {
                  "required": [
                    "iso"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "angle": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "required": [
            "value",
            "units"
          ],
          "properties": {
            "value": {
              "type": "number"
            },
            "units": {
              "enum": [
                "deg",
                "rad",
                "degrees",
                "radians"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "vector": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "direction": {
      "oneOf": [
        {
          "$ref": "#/$defs/vector"
        },
        {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "$ref": "#/$defs/vector"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "positiveMoment": {
      "oneOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "units": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "faultAngles": {
      "type": "object",
      "required": [
        "strike",
        "dip",
        "rake"
      ],
      "properties": {
        "strike": {
          "$ref": "#/$defs/angle"
        },
        "dip": {
          "$ref": "#/$defs/angle"
        },
        "rake": {
          "$ref": "#/$defs/angle"
        },
        "angle_units": {
          "enum": [
            "deg",
            "rad",
            "degrees",
            "radians"
          ]
        },
        "units": {
          "enum": [
            "deg",
            "rad",
            "degrees",
            "radians"
          ]
        }
      },
      "additionalProperties": false
    },
    "clvdAxis": {
      "oneOf": [
        {
          "$ref": "#/$defs/direction"
        },
        {
          "type": "object",
          "required": [
            "azimuth",
            "plunge"
          ],
          "properties": {
            "azimuth": {
              "$ref": "#/$defs/angle"
            },
            "plunge": {
              "$ref": "#/$defs/angle"
            },
            "angle_units": {
              "enum": [
                "deg",
                "rad",
                "degrees",
                "radians"
              ]
            },
            "units": {
              "enum": [
                "deg",
                "rad",
                "degrees",
                "radians"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "strike",
            "dip"
          ],
          "properties": {
            "strike": {
              "$ref": "#/$defs/angle"
            },
            "dip": {
              "$ref": "#/$defs/angle"
            },
            "rake": {
              "$ref": "#/$defs/angle"
            },
            "angle_units": {
              "enum": [
                "deg",
                "rad",
                "degrees",
                "radians"
              ]
            },
            "units": {
              "enum": [
                "deg",
                "rad",
                "degrees",
                "radians"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
