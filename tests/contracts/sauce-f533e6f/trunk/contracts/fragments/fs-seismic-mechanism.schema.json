                },
                {
                  "required": [
                    "weight"
                  ],
                  "properties": {
                    "weight": {
                      "const": 0
                    }
                  }
                }
              ],
              "allOf": [
                {
                  "if": {
                    "allOf": [
                      {
                        "not": {
                          "required": [
                            "weight"
