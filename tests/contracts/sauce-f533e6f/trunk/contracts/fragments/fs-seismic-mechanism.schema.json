              "type": "string",
              "default": "global"
            },
            "convention": {
              "enum": [
                "local",
                "NED",
                "END",
                "ENU",
                "ned",
                "end",
                "enu"
              ]
            },
            "amplitude": {
              "$ref": "#/$defs/positiveMoment"
            },
            "moment_magnitude": {
