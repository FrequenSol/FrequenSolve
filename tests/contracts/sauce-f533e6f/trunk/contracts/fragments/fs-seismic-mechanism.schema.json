{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frequensolve.local/contracts/fragments/fs-seismic-mechanism.schema.json",
  "title": "Seismic source mechanisms",
  "$defs": {
    "mechanism": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "double_couple"
            },
            "system": {
              "type": "string",
              "default": "global"
            },
            "convention": {
              "enum": [
                "local",
                "NED",
                "END",
                "ENU",
                "ned",
                "end",
                "enu"
              ]
            },
            "amplitude": {
              "$ref": "#/$defs/positiveMoment"
            },
            "moment_magnitude": {
              "type": "number"
            },
            "units": {
              "type": "string"
            },
            "normalization": {
              "const": "scalar_moment"
            },
            "strike": {
              "$ref": "#/$defs/angle"
            },
            "dip": {
              "$ref": "#/$defs/angle"
            },
            "rake": {
              "$ref": "#/$defs/angle"
            },
            "angle_units": {
              "enum": [
                "deg",
                "rad",
                "degrees",
                "radians"
              ]
            },
            "fault_normal": {
              "$ref": "#/$defs/direction"
            },
            "slip_vector": {
              "$ref": "#/$defs/direction"
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "not": {
                "required": [
                  "amplitude",
                  "moment_magnitude"
                ]
              }
            },
            {
              "if": {
                "required": [
                  "moment_magnitude"
                ]
              },
              "then": {
                "not": {
                  "required": [
                    "units"
                  ]
                }
              }
            },
            {
              "if": {
                "required": [
                  "moment_magnitude"
                ]
              },
              "then": {
                "properties": {
                  "normalization": {
                    "const": "scalar_moment"
                  }
                }
              }
            },
            {
              "if": {
                "required": [
                  "strike"
                ]
              },
              "then": {
                "not": {
                  "required": [
                    "convention"
                  ]
                }
              }
            }
          ],
          "oneOf": [
            {
              "required": [
                "strike",
                "dip",
                "rake"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "fault_normal"
                    ]
                  },
                  {
                    "required": [
                      "slip_vector"
                    ]
                  },
                  {
                    "required": [
                      "axis"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "fault_normal",
                "slip_vector"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "strike"
                    ]
                  },
                  {
                    "required": [
                      "dip"
                    ]
                  },
                  {
                    "required": [
                      "rake"
                    ]
                  },
                  {
                    "required": [
                      "axis"
                    ]
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "object",
          "required": [
            "type",
            "axis"
          ],
          "properties": {
            "type": {
              "const": "clvd"
            },
            "system": {
              "type": "string",
              "default": "global"
            },
            "convention": {
              "enum": [
                "local",
                "NED",
                "END",
                "ENU",
                "ned",
                "end",
                "enu"
              ]
            },
            "amplitude": {
              "$ref": "#/$defs/positiveMoment"
            },
            "moment_magnitude": {
              "type": "number"
            },
            "units": {
              "type": "string"
            },
            "normalization": {
              "const": "scalar_moment"
            },
            "axis": {
              "$ref": "#/$defs/clvdAxis"
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "not": {
                "required": [
                  "amplitude",
                  "moment_magnitude"
                ]
              }
            },
            {
              "if": {
                "required": [
                  "moment_magnitude"
                ]
              },
              "then": {
                "not": {
                  "required": [
                    "units"
                  ]
                }
              }
            },
            {
              "if": {
                "required": [
                  "moment_magnitude"
                ]
              },
              "then": {
                "properties": {
                  "normalization": {
                    "const": "scalar_moment"
                  }
                }
              }
            },
            {
              "if": {
                "required": [
                  "axis"
                ],
                "properties": {
                  "axis": {
                    "anyOf": [
                      {
                        "required": [
                          "strike"
                        ]
                      },
                      {
                        "required": [
                          "azimuth"
                        ]
                      }
                    ],
                    "type": "object"
                  }
                }
              },
              "then": {
                "not": {
                  "required": [
                    "convention"
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "required": [
            "type",
            "tensor"
          ],
          "properties": {
            "type": {
              "const": "moment_tensor"
            },
            "system": {
              "type": "string",
              "default": "global"
            },
            "convention": {
              "enum": [
                "local",
                "NED",
                "END",
                "ENU",
                "ned",
                "end",
                "enu"
              ]
            },
            "amplitude": {
              "$ref": "#/$defs/positiveMoment"
            },
            "moment_magnitude": {
              "type": "number"
            },
            "units": {
              "type": "string"
            },
            "normalization": {
              "const": "scalar_moment"
            },
            "tensor": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "$ref": "#/$defs/vector"
              }
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "not": {
                "required": [
                  "amplitude",
                  "moment_magnitude"
                ]
              }
            },
            {
              "if": {
                "required": [
                  "moment_magnitude"
                ]
              },
              "then": {
                "not": {
                  "required": [
                    "units"
                  ]
                }
              }
            },
            {
              "if": {
                "required": [
                  "moment_magnitude"
                ]
              },
              "then": {
                "properties": {
                  "normalization": {
                    "const": "scalar_moment"
                  }
                }
              }
            }
          ]
