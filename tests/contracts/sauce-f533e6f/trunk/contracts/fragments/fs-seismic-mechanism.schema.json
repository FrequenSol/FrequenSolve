                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "fault_normal"
                        ]
                      },
                      {
                        "required": [
                          "slip_vector"
                        ]
                      },
                      {
                        "required": [
                          "axis"
                        ]
                      }
                    ]
                  }
                },
                {
                  "required": [
                    "fault_normal",
                    "slip_vector"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "strike"
                        ]
                      },
                      {
                        "required": [
                          "dip"
                        ]
                      },
                      {
                        "required": [
                          "rake"
                        ]
                      },
                      {
                        "required": [
                          "axis"
                        ]
                      }
                    ]
                  }
                },
                {
                  "required": [
                    "axis"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "strike"
                        ]
                      },
                      {
                        "required": [
                          "dip"
                        ]
                      },
                      {
                        "required": [
                          "rake"
                        ]
                      },
                      {
                        "required": [
                          "fault_normal"
                        ]
                      },
                      {
                        "required": [
                          "slip_vector"
                        ]
                      }
                    ]
                  }
                }
              ],
              "allOf": [
                {
                  "if": {
                    "allOf": [
                      {
                        "not": {
                          "required": [
                            "weight"
                          ],
                          "properties": {
                            "weight": {
                              "const": 0
                            }
                          }
                        }
                      },
                      {
                        "anyOf": [
                          {
                            "required": [
                              "strike"
                            ]
                          },
                          {
                            "required": [
                              "axis"
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  "then": {
                    "not": {
                      "required": [
                        "convention"
                      ]
                    }
                  }
                }
              ]
            },
            "clvd": {
              "type": "object",
              "properties": {
                "system": {
                  "type": "string",
                  "default": "global"
                },
                "convention": {
                  "enum": [
                    "local",
                    "NED",
                    "END",
                    "ENU",
                    "ned",
                    "end",
                    "enu"
                  ]
                },
                "weight": {
                  "type": "number"
                },
                "axis": {
                  "$ref": "#/$defs/clvdAxis"
