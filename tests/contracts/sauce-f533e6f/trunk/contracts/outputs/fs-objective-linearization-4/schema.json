{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fs-objective-linearization-4",
  "description": "Frozen FWI objective state for one frequency task, stored as canonical rows in one HDF5 cache independent of the MPI partition.",
  "type": "object",
  "required": [
    "schema",
    "task",
    "state_fingerprint",
    "frequency_hz",
    "laplace_damping_hz",
    "fingerprints",
    "terms",
    "runtime"
  ],
  "properties": {
    "schema": {
      "const": "fs-objective-linearization-4"
    },
    "task": {
      "type": "integer",
      "minimum": 1
    },
    "state_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "frequency_hz": {
      "type": "number"
    },
    "laplace_damping_hz": {
      "type": "number"
    },
    "fingerprints": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "n_terms"
      ],
      "properties": {
        "n_terms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "receiver_group",
          "cache",
          "layout_fingerprint",
          "runtime"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "receiver_group": {
            "type": "string"
          },
          "cache": {
            "type": "object",
            "required": [
              "file",
              "group"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1,
                "description": "HDF5 cache, absolute or relative to the manifest directory; terms may share it."
              },
              "group": {
                "type": "string",
                "pattern": "^/terms/[0-9]+$"
              }
            },
            "additionalProperties": false
          },
          "layout_fingerprint": {
            "type": "string"
          },
          "runtime": {
            "type": "object",
            "required": [
              "cache_fingerprint"
            ],
            "properties": {
              "cache_fingerprint": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
