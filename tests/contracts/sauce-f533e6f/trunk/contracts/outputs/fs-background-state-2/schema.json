{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Material background checkpoint manifest, version 2",
  "description": "Forward fields of one ordinary material linearization task, in one HDF5 file shared by every MPI rank or one file per rank, restorable on the same rank count.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "layout",
    "storage",
    "context",
    "state",
    "build",
    "ranks",
    "slabs",
    "batches"
  ],
  "properties": {
    "schema": {
      "const": "fs-background-state-2"
    },
    "layout": {
      "enum": [
        "shared",
        "rank"
      ]
    },
    "storage": {
      "enum": [
        "l2",
        "full"
      ]
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "minLength": 1
    },
    "build": {
      "type": "string",
      "minLength": 1
    },
    "ranks": {
      "type": "integer",
      "minimum": 1
    },
    "file": {
      "type": "string",
      "minLength": 1,
      "description": "Shared layout: the HDF5 file holding every rank's slab, relative to the manifest directory or absolute."
    },
    "shards": {
      "type": "array",
      "minItems": 1,
      "description": "Rank layout, indexed by zero-based MPI rank: the HDF5 file holding that rank's slab, relative to the manifest directory or absolute.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "slabs": {
      "type": "array",
      "minItems": 1,
      "description": "Indexed by zero-based MPI rank: the rank's payload columns and the first of them in the rank-ordered concatenation of every batch's values.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "columns",
          "offset"
        ],
        "properties": {
          "columns": {
            "type": "integer",
            "minimum": 0
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "batches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_first",
          "n_sources",
          "digest"
        ],
        "properties": {
          "source_first": {
            "type": "integer",
            "minimum": 1
          },
          "n_sources": {
            "type": "integer",
            "minimum": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^fs-block-sha256-1:[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "layout": {
            "const": "shared"
          }
        }
      },
      "then": {
        "required": [
          "file"
        ],
        "not": {
          "required": [
            "shards"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "layout": {
            "const": "rank"
          }
        }
      },
      "then": {
        "required": [
          "shards"
        ],
        "not": {
          "required": [
            "file"
          ]
        }
      }
    }
  ]
}
