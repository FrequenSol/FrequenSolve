{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fs-objective-vector-3",
  "type": "object",
  "required": [
    "schema",
    "state_fingerprint",
    "manifest_fingerprint",
    "partition",
    "shards",
    "terms"
  ],
  "properties": {
    "schema": {
      "const": "fs-objective-vector-3"
    },
    "state_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "manifest_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "partition": {
      "type": "object",
      "required": [
        "n_ranks",
        "compatibility"
      ],
      "properties": {
        "n_ranks": {
          "type": "integer",
          "minimum": 1
        },
        "compatibility": {
          "const": "same_mesh_partition"
        }
      },
      "additionalProperties": false
    },
    "shards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "file",
          "sha256"
        ],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "n_global_rows",
          "layout_fingerprint"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "n_global_rows": {
            "type": "integer",
            "minimum": 0
          },
          "layout_fingerprint": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
