{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frequensolve.local/contracts/outputs/fs-objective-report-1/schema.json",
  "title": "FS Objective Report v1",
  "x-fs-contract": "fs-objective-report-1",
  "x-fs-visibility": "public",
  "x-fs-status": "initial",
  "x-fs-docs": true,
  "type": "object",
  "required": ["schema", "total", "terms"],
  "properties": {
    "schema": {"const": "fs-objective-report-1"},
    "state_fingerprint": {"type": "string"},
    "total": {"type": "number"},
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "raw_sum", "effective_weight_mass", "normalized_value", "weight", "weighted_value", "active_samples", "scale"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "raw_sum": {"type": "number"},
          "effective_weight_mass": {"type": "number", "exclusiveMinimum": 0},
          "normalized_value": {"type": "number"},
          "weight": {"type": "number", "exclusiveMinimum": 0},
          "weighted_value": {"type": "number"},
          "active_samples": {"type": "integer", "minimum": 1},
          "scale": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0}},
          "robust": {"type": "object", "additionalProperties": true}
        },
        "additionalProperties": false
      }
    },
    "runtime": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false
}
