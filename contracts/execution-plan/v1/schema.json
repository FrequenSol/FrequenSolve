{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.frequensol.com/execution-plan/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "frequency-execution-plan.v1"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]{1,80}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "artifacts_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "solver_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "runtime_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "site_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "catalog_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "execution_site_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "sizing_policy_version": {
          "const": "memory-fit-first.v1"
        },
        "memory_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "calibration_numerator": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "calibration_denominator": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "worker_overhead_mib": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "minimum_memory_mib": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "calibration_numerator",
            "calibration_denominator",
            "worker_overhead_mib",
            "minimum_memory_mib"
          ]
        }
      },
      "required": [
        "input_digest",
        "artifacts_digest",
        "solver_digest",
        "runtime_digest",
        "site_fingerprint",
        "catalog_digest",
        "execution_site_id",
        "sizing_policy_version",
        "memory_policy"
      ]
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 96,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "frequency_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 95
          },
          "frequency": {
            "type": "string",
            "pattern": "^-?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$"
          },
          "automatic": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "layout": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "partition": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                      },
                      "node_type": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                      },
                      "nodes": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "ranks_per_node": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "cpus_per_rank": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "partition",
                      "node_type",
                      "nodes",
                      "ranks_per_node",
                      "cpus_per_rank"
                    ]
                  },
                  "memory_mib_per_node": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "wall_time_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "layout",
                  "memory_mib_per_node",
                  "wall_time_seconds"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "requested": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "layout": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "partition": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                      },
                      "node_type": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                      },
                      "nodes": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "ranks_per_node": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "cpus_per_rank": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "partition",
                      "node_type",
                      "nodes",
                      "ranks_per_node",
                      "cpus_per_rank"
                    ]
                  },
                  "memory_mib_per_node": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "wall_time_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "layout",
                  "memory_mib_per_node",
                  "wall_time_seconds"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "overrides": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "validation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "valid",
                  "needs_validation",
                  "invalid"
                ]
              },
              "sizing_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "allocation_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "minimum_memory_mib_per_node": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "status"
            ]
          },
          "reason": {
            "type": "string"
          },
          "estimated_runtime_seconds": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        },
        "required": [
          "frequency_index",
          "frequency",
          "automatic",
          "requested",
          "overrides",
          "validation",
          "reason",
          "estimated_runtime_seconds"
        ]
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_nodes_per_frequency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_concurrent_frequencies": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_running_cpus": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_wall_time_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_layout_evaluations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      },
      "required": [
        "max_nodes_per_frequency",
        "max_concurrent_frequencies",
        "max_running_cpus",
        "max_wall_time_seconds",
        "max_layout_evaluations"
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "version",
    "plan_id",
    "revision",
    "context",
    "rows",
    "limits",
    "digest"
  ]
}
